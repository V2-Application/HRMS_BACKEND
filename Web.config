<?xml version="1.0" encoding="utf-8"?>
<!--
  Checked in so the published web.config carries the two IIS limits the bulk
  uploaders need. Without this file the SDK generates a default one on every
  publish and both settings silently revert.

  requestTimeout — the AspNetCoreModule default is 2 MINUTES. A medical-card
    archive is uploaded as ONE request and the server expands it, saves every
    PDF and parses each card, which measured 8.4 minutes for the 1,813-file
    Aug-2026 batch on dev. At the default the request is killed part-way with a
    502.3 and the import silently half-completes.

  maxAllowedContentLength — IIS caps request bodies at 30 MB by default and
    rejects anything larger with 404.13, before the app ever sees it. Raised to
    match the 2 GB [RequestSizeLimit] already on MedicalCardController.BulkUpload.

  The SDK rewrites processPath/arguments/hostingModel at publish time and leaves
  everything else here intact.
-->
<configuration>
  <system.web>
    <compilation targetFramework="4.8" debug="true" />
    <pages controlRenderingCompatibilityVersion="4.0" />
  </system.web>
  <system.webServer>
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="2147483648" />
      </requestFiltering>
    </security>
    <handlers>
      <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
    </handlers>
    <aspNetCore processPath="dotnet"
                arguments=".\HRMSAPI.dll"
                stdoutLogEnabled="false"
                stdoutLogFile=".\logs\stdout"
                hostingModel="inprocess"
                requestTimeout="00:30:00" />
  </system.webServer>
</configuration>
