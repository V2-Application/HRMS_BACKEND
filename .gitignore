## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# Build results
bin/
obj/
out/
wwwroot/
# User-specific files
*.user
*.suo
*.userosscache
*.sln.docstates

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# Rider project files
.idea/

# VS Code settings
.vscode/
.vs/

# Mac system files
.DS_Store

# Windows image file caches
Thumbs.db

# DotCover
*.dotCover

# NCrunch
*.ncrunch*
.*crunch*.local.xml

# Backup & report files from converting an old project file
_UpgradeReport_Files/
Backup*/
UpgradeLog*.XML

# DotNet CLI
project.lock.json
project.fragment.lock.json
artifacts/

# ASP.NET Core
wwwroot/lib/
node_modules/
npm-debug.log
yarn-error.log

# Azure Pipelines
.vsts/

# Local SQL databases
*.mdf
*.ldf

# Logs
*.log

# Test results
TestResults/
*.trx
*.coverage
*.coveragexml
*.testsettings

# Publish output
publish/

# # Secrets
# secrets.json
# appsettings.json
# appsettings.Development.json
# appsettings.Local.json

# Docker files
**/.dockerignore
**/Dockerfile
docker-compose*.yml

# Resharper files
*.DotSettings.user

# EF Core
Migrations/

# Python
__pycache__/

# Temp Excel files
~$*.xlsx

# Build output files
build_error.txt
build_output.txt
